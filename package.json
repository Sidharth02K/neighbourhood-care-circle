{
  "name": "neighbourhood-care-circle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A consent-first neighbourhood social continuity prototype",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "repair-demo": "npm --prefix server run repair-demo",
    "build": "npm --prefix client run build",
    "build:vercel": "npm run build && node scripts/copy-client-dist.js",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
